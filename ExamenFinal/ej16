Algoritmo AdivinaElNumero
	Definir numSecreto, numeroIngresado, intentos Como Entero
	
	numSecreto <- 7
	intentos <- 0
	
	Repetir
		Escribir "Adivina el número (ingresa un valor):"
		Leer numeroIngresado
		
		intentos <- intentos + 1
		
		Si numeroIngresado < numSecreto Entonces
			Escribir "Más alto"
		SiNo
			Si numeroIngresado > numSecreto Entonces
				Escribir "Más bajo"
			FinSi
		FinSi
		
	Hasta Que numeroIngresado = numSecreto
	
	Escribir "¡Acertaste! Intentos: ", intentos
FinAlgoritmo
